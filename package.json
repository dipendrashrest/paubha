{
  "name": "paubha-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:registry": "pnpm --filter @paubha/registry build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm check:consistency && biome check .",
    "check:consistency": "node scripts/check-consistency.mjs",
    "test": "turbo test",
    "sync:tokens": "pnpm --filter @paubha/registry sync:tokens"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0"
}
